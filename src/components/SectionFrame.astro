---
const { title, eyebrow = '', id = '' } = Astro.props;
---

<section id={id} class="section-frame rounded-2xl border border-terminal-border bg-terminal-panel shadow-terminal">
  <div class="border-b border-terminal-border/70 px-4 py-3 sm:px-6">
    {eyebrow ? <p class="text-xs uppercase tracking-[0.25em] text-terminal-muted">{eyebrow}</p> : null}
    <h2 class="mt-1 text-lg font-semibold text-terminal-text sm:text-xl">{title}</h2>
  </div>
  <div class="px-4 py-5 sm:px-6">
    <slot />
  </div>
</section>

<style>
  .section-frame {
    scroll-margin-top: 1.5rem;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease,
      background-color 160ms ease;
  }

  .section-frame h2 {
    transition:
      color 160ms ease,
      text-shadow 160ms ease;
  }

  .section-frame.is-flash {
    border-color: rgba(245, 211, 106, 0.82);
    background-color: rgba(245, 211, 106, 0.03);
    box-shadow:
      0 0 0 1px rgba(245, 211, 106, 0.28),
      0 0 24px rgba(245, 211, 106, 0.12),
      0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .section-frame.is-flash h2 {
    color: #f5d36a;
    text-shadow: 0 0 14px rgba(245, 211, 106, 0.34);
    animation: section-title-pulse 700ms ease-out;
  }

  @keyframes section-title-pulse {
    0% {
      transform: translateY(0);
      text-shadow: 0 0 0 rgba(245, 211, 106, 0);
    }

    50% {
      transform: translateY(-1px);
      text-shadow: 0 0 18px rgba(245, 211, 106, 0.45);
    }

    100% {
      transform: translateY(0);
      text-shadow: 0 0 14px rgba(245, 211, 106, 0.34);
    }
  }
</style>
