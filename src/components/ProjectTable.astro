---
const { projects = [] } = Astro.props;

const linkTypes = ['website', 'github', 'youtube'];

const linkLabel = {
  website: 'website',
  github: 'GitHub repository',
  youtube: 'YouTube',
};

const linkSvg = {
  website:
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>',
  github:
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.62 2 12.31c0 4.55 2.87 8.41 6.84 9.78.5.1.68-.22.68-.5v-1.95c-2.78.62-3.37-1.22-3.37-1.22-.46-1.22-1.13-1.55-1.13-1.55-.92-.65.07-.64.07-.64 1.02.08 1.56 1.08 1.56 1.08.9 1.6 2.35 1.14 2.93.87.09-.67.35-1.14.63-1.4-2.22-.26-4.56-1.14-4.56-5.08 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.06a9.14 9.14 0 0 1 5 0c1.9-1.34 2.75-1.06 2.75-1.06.55 1.42.2 2.47.1 2.73.64.72 1.03 1.64 1.03 2.76 0 3.95-2.34 4.82-4.57 5.07.36.32.68.95.68 1.92v2.84c0 .28.18.61.69.5A10.38 10.38 0 0 0 22 12.31C22 6.62 17.52 2 12 2Z"></path></svg>',
  youtube:
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path><path d="m10 15 5-3-5-3z"></path></svg>',
};
---

<div class="overflow-hidden rounded-xl border border-terminal-border/70 bg-terminal-bg">
  <div class="overflow-x-auto">
    <table class="min-w-full border-collapse text-left text-sm">
      <thead class="bg-terminal-panelAlt text-terminal-muted max-sm:sr-only">
        <tr>
          <th class="px-4 py-3 font-medium">Project</th>
          <th class="px-4 py-3 font-medium">Stack</th>
          <th class="px-4 py-3 font-medium">Focus</th>
          <th class="px-4 py-3 font-medium">Status</th>
        </tr>
      </thead>
      <tbody>
        {projects.map((project) => (
          <tr class="border-t border-terminal-border/50 max-sm:flex max-sm:flex-col max-sm:gap-2 max-sm:border max-sm:border-terminal-border/50 max-sm:rounded-xl max-sm:p-4 max-sm:mb-3">
            <td class="px-4 py-4 align-top font-medium text-terminal-text max-sm:px-0 max-sm:py-0" data-label="Project">
              <div class="space-y-3 max-sm:flex max-sm:items-center max-sm:gap-3 max-sm:space-y-0">
                {project.thumbnailUrl ? (
                  <img
                    class="project-thumb max-sm:w-12 max-sm:h-12"
                    src={project.thumbnailUrl}
                    alt={project.thumbnailAlt || `${project.name} preview`}
                    loading="lazy"
                  />
                ) : null}
                <div class="min-w-0">
                  <span class="block leading-none text-terminal-text">{project.name}</span>
                  <div class="mt-3 flex items-center gap-2">
                    {linkTypes.map((type) => {
                      const href = project[`${type}Url`];
                      const label = linkLabel[type];

                      return href ? (
                        <a
                          class="project-icon-link"
                          href={href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${project.name} ${label}`}
                          set:html={linkSvg[type]}
                        />
                      ) : (
                        <span class="project-icon-link is-disabled" aria-hidden="true" set:html={linkSvg[type]} />
                      );
                    })}
                  </div>
                </div>
              </div>
            </td>
            <td class="px-4 py-4 align-top text-terminal-muted max-sm:px-0 max-sm:py-0"><span class="sr-only max-sm:not-sr-only max-sm:text-terminal-muted max-sm:text-xs">Stack: </span>{project.stack}</td>
            <td class="px-4 py-4 align-top text-terminal-muted max-sm:px-0 max-sm:py-0"><span class="sr-only max-sm:not-sr-only max-sm:text-terminal-muted max-sm:text-xs">Focus: </span>{project.focus}</td>
            <td class="px-4 py-4 align-top text-terminal-accent max-sm:px-0 max-sm:py-0">
              <span class="sr-only max-sm:not-sr-only max-sm:text-terminal-muted max-sm:text-xs">Status: </span>
              {project.status === 'Live' ? <span class="live-dot" aria-hidden="true"></span> : null}
              {project.status}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .project-thumb {
    display: block;
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: 0.75rem;
    border: 1px solid rgba(33, 65, 106, 0.7);
    background: #08111d;
    box-shadow: 0 0 0 1px rgba(158, 210, 255, 0.05), 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  .project-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgba(33, 65, 106, 0.7);
    border-radius: 0.5rem;
    background: rgba(8, 17, 29, 0.6);
    color: #9fb3c9;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .project-icon-link:hover,
  .project-icon-link:focus-visible {
    color: #f5d36a;
    border-color: #f5d36a;
    background-color: rgba(245, 211, 106, 0.12);
    box-shadow:
      0 0 0 1px rgba(245, 211, 106, 0.2),
      0 0 12px rgba(245, 211, 106, 0.15);
    transform: translateY(-1px);
  }

  .project-icon-link.is-disabled {
    opacity: 0.35;
    pointer-events: none;
    border-color: rgba(33, 65, 106, 0.35);
    box-shadow: none;
    transform: none;
  }

  .live-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.5rem;
    border-radius: 9999px;
    background: #34d399;
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
    animation: live-pulse 2s ease-out infinite;
  }

  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(52, 211, 153, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(52, 211, 153, 0);
    }
  }
</style>
